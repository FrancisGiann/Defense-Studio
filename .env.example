# Add your own key locally. Never paste a key in chat or commit .env.
# Sample mode works with no key and sends nothing to an AI service.
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Conservative application limits; provider limits can differ.
GROQ_DAILY_CALL_LIMIT=30
GROQ_REQUEST_GAP_MS=30000
PORT=4317
